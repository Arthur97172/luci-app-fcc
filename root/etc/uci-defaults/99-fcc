#!/bin/sh
# luci-app-fcc — first-install defaults.
#
# This script runs once, on package install. It is intentionally tiny: it only
# creates the UCI config if missing and clears the LuCI caches. It MUST NOT
# download the FCC runtime — that is an explicit, user-initiated action from the
# LuCI UI (see DESIGN_SPEC.md section 82).

[ -n "$IPKG_INSTROOT" ] && exit 0

# Seed default config (idempotent — uci-defaults runs before /etc/config exists
# only if the conffile was not preserved).
if [ ! -f /etc/config/fcc ]; then
	cat > /etc/config/fcc <<-'EOF'
		config fcc 'main'
			option enabled '1'
			option install_path '/opt/fcc'
			option backup_path '/tmp/fcc'
			option port '8082'
			option bind '127.0.0.1'
			option auto_start '1'
			option session_backend 'tmux'
			option agent_backend 'python'
			option log_level 'info'
			option backup_keep '3'
			option control_target 'local'
			option remote_host ''
			option remote_user ''
			option remote_ssh_port '22'
			option remote_admin_port '8082'
			option remote_platform 'linux'
			option remote_service 'fcc'
			option remote_fingerprint ''
	EOF
fi

# Clear LuCI index/module caches so the new menu entry appears immediately.
# The ucode dispatcher names its cache luci-indexcache.<hash>.json, so a run of
# this script on its own has to remove that form as well; default_postinst()
# removes both during an install. Removing only the bare name leaves a cached
# menu that predates the package, which is what hid FCC from Services after a
# failed upgrade on 2026-10-21.
rm -f /tmp/luci-indexcache /tmp/luci-indexcache.*.json 2>/dev/null
rm -rf /tmp/luci-modulecache 2>/dev/null

exit 0
