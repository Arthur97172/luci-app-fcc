# luci-app-fcc — credential patterns for the secret scan in test_security.sh.
#
# One POSIX ERE per line; blank lines and lines starting with # are ignored.
# This file is excluded from its own scan (the PEM rule below matches the text
# of the rule itself), so it must never contain a real credential.

# GitHub tokens, all prefixes.
gh[pousr]_[A-Za-z0-9]{20,}
github_pat_[A-Za-z0-9_]{20,}

# Anthropic / OpenAI style API keys.
sk-ant-[A-Za-z0-9_-]{20,}
sk-[A-Za-z0-9]{32,}

# AWS access key ids.
AKIA[0-9A-Z]{16}

# Slack tokens.
xox[baprs]-[A-Za-z0-9-]{10,}

# Private keys.
-----BEGIN [A-Z ]*PRIVATE KEY-----
